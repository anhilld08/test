
#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, k1, k2;
    cin >> n >> k1 >> k2;

    vector<long long> S0(n + 1, 0);
    vector<long long> S1(n + 1, 0);

    S0[0] = 1;
    S0[1] = 1;

    for (int i = k1; i <= n; i++) {
        S1[i] = 0;

        for (int j = k1; j <= k2; j++) {
            if (i - j >= 0) {
                S1[i] += S0[i - j];
            }
        }

        if (i < n) {
            S0[i + 1] = S1[i];
        }
    }

    cout << S0[n] + S1[n];

    return 0;
}
