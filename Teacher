#include <bits/stdc++.h>
using namespace std;

int m, n;
int bestcnt = INT_MAX;          
int cnt = 0;                    
int lower_;                     
vector<vector<int>> lst;        
vector<int> subject;            
vector<int> load;               
vector<vector<bool>> same;      

bool has(int i, int k) {
    for (int y : lst[i])
        if (y == k) return true;
    return false;
}

bool check(int j, int k) {
    if (!has(j, k)) return false;
    for (int i = 1; i < k; i++)
        if (subject[i] == j && same[i][k]) return false;
    return true;
}

void Try(int k) {
    if (bestcnt == lower_) return;              
    if (k > n) {
        bestcnt = cnt;
        return;
    }
    for (int j = 1; j <= m; j++) {
        if (load[j] + 1 >= bestcnt) continue;  
        if (!check(j, k)) continue;

        subject[k] = j;
        load[j]++;
        int old = cnt;
        cnt = max(cnt, load[j]);

        Try(k + 1);

        cnt = old;
        load[j]--;
        subject[k] = 0;
    }
}

int main() {
    cin >> m >> n;
    lst.assign(m + 1, {});
    subject.assign(n + 1, 0);
    load.assign(m + 1, 0);
    same.assign(n + 1, vector<bool>(n + 1, false));
    lower_ = (n + m - 1) / m;

    for (int i = 1; i <= m; i++) {
        int numb, x;
        cin >> numb;
        while (numb--) {
            cin >> x;
            lst[i].push_back(x);
        }
    }

    int K;
    cin >> K;
    while (K--) {
        int a, b;
        cin >> a >> b;
        same[a][b] = same[b][a] = true;
    }

    Try(1);
    cout << (bestcnt == INT_MAX ? -1 : bestcnt) << "\n";
    return 0;
}
