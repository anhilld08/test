#include <bits/stdc++.h>
using namespace std;

int n, c;
vector<int> a;

bool check(int d) {
    int cnt = 1;
    int last = a[0];

    for(int i = 1; i < n; i++) {
        if(a[i] - last >= d) {
            cnt++;
            last = a[i];
        }

        if(cnt >= c) return true;
    }

    return false;
}

int main() {
    int T;
    cin >> T;

    while(T--) {
        cin >> n >> c;

        a.resize(n);

        for(int i = 0; i < n; i++) {
            cin >> a[i];
        }

        sort(a.begin(), a.end());

        int l = 0;
        int r = (a[n-1] - a[0]) / (c-1);
        int ans = 0;

        while(l <= r) {
            int mid = l + (r-l)/2;

            if(check(mid)) {
                ans = mid;
                l = mid + 1;
            }
            else {
                r = mid - 1;
            }
        }

        cout << ans << '\n';
    }

    return 0;
}
