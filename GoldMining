#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, L1, L2;
    if (!(cin >> n >> L1 >> L2)) return 0;

    vector<long long> a(n + 1), dp(n + 1, 0);
    for (int i = 1; i <= n; ++i) {
        cin >> a[i];
    }

    deque<int> dq;
    long long ans = 0;

    for (int i = 1; i <= n; ++i) {
        int addIdx = i - L1;
        if (addIdx >= 1) {
            while (!dq.empty() && dp[dq.back()] <= dp[addIdx]) {
                dq.pop_back();
            }
            dq.push_back(addIdx);
        }

        while (!dq.empty() && dq.front() < i - L2) {
            dq.pop_front();
        }

        long long bestPrev = dq.empty() ? 0 : dp[dq.front()];
        dp[i] = a[i] + bestPrev;
        ans = max(ans, dp[i]);
    }

    cout << ans << '\n';
    return 0;
}
