
#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, T, D;
    cin >> n >> T >> D;

    int a[n + 1], t[n + 1];

    for (int i = 1; i <= n; i++) {
        cin >> a[i];
    }

    for (int i = 1; i <= n; i++) {
        cin >> t[i];
    }

    vector<vector<long long>> f(n + 1, vector<long long>(T + 1, 0));

    long long ans = 0;

    for (int i = 1; i <= n; i++) {
        for (int k = t[i]; k <= T; k++) {

            f[i][k] = a[i];

            for (int j = max(1, i - D); j < i; j++) {
                f[i][k] = max(f[i][k], f[j][k - t[i]] + a[i]);
            }

            ans = max(ans, f[i][k]);
        }
    }

    cout << ans;

    return 0;
}
